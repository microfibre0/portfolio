<div class="flex h-screen h-dvh flex-col overflow-hidden">
  <header class="website-header flex shrink-0 justify-between border py-6">
    <h3 class="website-header-title mb-2 ml-6 text-[1.75rem] font-medium leading-[1.2]"> My Projects </h3>
    <h3 class="website-header-title mb-2 mr-6 text-[1.75rem] font-medium leading-[1.2]"> </h3>
    <div></div>
  </header>

  <div
    class="website-page grid min-h-0 flex-1 grid-cols-[minmax(0,1fr)_minmax(0,5fr)]"
    data-controller="websites"
  >
    <nav class="website-nav min-w-0 overflow-y-auto border">
      <%= link_to "welcome", root_path,
       class: "website-nav-link block border px-5 py-3 no-underline" ,
       data: {turbo_frame: :projects}%>

      <%= link_to "about me", about_me_path,
       class: "website-nav-link block border px-5 py-3 no-underline" ,
       data: {turbo_frame: :projects}%>

      <%= link_to "gradient_maker", gradient_maker_path,
       class: "website-nav-link block border px-5 py-3 no-underline" ,
       data: {turbo_frame: :projects}%>
      <!-- websites url list -->
      <%= link_to "my linked in", leaving_site_path(url: "https://www.linkedin.com/in/eitan-hoyte-546021297/"),
       class: "website-nav-link website-nav-link--external block border px-5 py-3 no-underline",
       data: {turbo_frame: :projects}%>

      <%= link_to "my git hub", leaving_site_path(url: "https://github.com/microfibre0"),
       class: "website-nav-link website-nav-link--external block border px-5 py-3 no-underline",
       data: {turbo_frame: :projects}%>
    </nav>

    <main class="min-h-0 min-w-0 p-6">
      <div class="website-content-frame h-full min-h-0 overflow-auto border">
        <%= turbo_frame_tag :projects, class: "block h-full" do %>
          <%= render "shared/default" %>
        <% end %>
      </div>
    </main>
  </div>
</div>
