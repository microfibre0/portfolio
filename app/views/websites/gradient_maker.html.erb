<%= turbo_frame_tag :projects, class: "block h-full" do %>
<div data-controller="gradient-maker" data-gradient-maker-target="background" class="relative h-full bg-[#f8f9fa]">
  <!-- color wheel -->
  <div class="absolute hidden flex h-[200px] w-[200px] flex-col items-center justify-between rounded-md border border-[#dee2e6] bg-[rgba(11,12,16,0.75)] py-1" data-gradient-maker-target="color_wheel_container">
    <div class="flex flex-col items-center gap-2">
      <div class="flex items-center gap-6">
        <p class="mx-6 text-white"></p>
        <p class="m-0 pt-1 text-white" data-gradient-maker-target="color_wheel_label">######</p>
        <button class="flex h-5 w-[50px] items-center justify-center rounded-full border-0 bg-[#dc3545] text-white" data-action="click->gradient-maker#remove_color click->gradient-maker#display_gradient"><span>del</span></button>
      </div>
      <input class="w-[180px]" type="color" data-gradient-maker-target="color_input"/>
      <input class="w-[180px]" type="range" min="1" max="360" data-gradient-maker-target="range_input" data-action="click->gradient-maker#displayDeg"/>
      <p class="text-white" data-gradient-maker-target="deg_display">180deg</p>
    </div>
    <button class="rounded-full border-0 bg-[#198754]" data-action="click->gradient-maker#Pick_color_val click->gradient-maker#display_gradient">enter</button>
  </div>
  <!-- end color wheel -->


  <!-- color container -->
  <div class="absolute bottom-4 left-1/2 w-[65vw] -translate-x-1/2 rounded-md border border-[#dee2e6] bg-[rgba(11,12,16,0.75)] py-6 min-[1200px]:w-[45vw]">
      <div class="grid max-h-[90px] grid-cols-4 overflow-y-auto px-12" data-gradient-maker-target="colors">
        <!--colors gened here-->

      </div>
      <button class="absolute flex h-10 w-[100px] items-center justify-center rounded-full border-0 p-0" data-action="click->gradient-maker#add_color"><span>add color</span></button>

    <div class="mx-auto mr-4 max-h-[60px] w-3/4 overflow-y-auto border border-[#dee2e6] bg-white px-1 py-2" data-gradient-maker-target="color_css">
      text
    </div>

  </div>
  <!-- end color container -->


</div>
<% end %>
